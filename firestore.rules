rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN';
    }

    // Helper function to check if user is accessing their own document
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAuthenticated(); // Users can read other users (for admin list, etc) - refine later
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /messes/{messId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin(); 
      allow update: if isAdmin(); // Only allow update if user is the admin of THIS mess - refine later
    }

    match /menus/{menuId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /weekly_menus/{messId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /dietBalances/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /availability/{availabilityId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated(); // Users update their own availability - need to validate uid in document
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.auth.uid == resource.data.toUid;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.toUid || request.auth.uid == resource.data.fromUid);
    }
    
    match /attendance/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /attendance/{docId}/records/{uid} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
